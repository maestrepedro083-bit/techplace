DirectoryIndex index.html
RewriteEngine On
RewriteRule ^_tecnologia(?:/|$) - [F,L,NC]
RewriteRule ^(?:api(?:/.*)?|parts-catalog\.json|film-catalog\.json)$ api.php [L,QSA]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'"
</IfModule>
